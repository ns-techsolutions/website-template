# Docker Compose deployment env. Copy to `.env` on the server and fill in.
#   cp .env.docker.example .env
# This file is read by docker-compose.yml (postgres) and injected into the
# `app` and `tools` containers (env_file). Never commit the real `.env`.
#
# Inside the Compose network the database host is the SERVICE NAME `postgres`,
# not localhost.

# --- Postgres service (the container in docker-compose.yml) --------------------
POSTGRES_USER=sma
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sma_control

# --- Control-plane database (registry of salons + master admins) ---------------
# Same instance/credentials as the postgres service above; host = `postgres`.
CONTROL_DATABASE_URL="postgresql://sma:change-me-strong-password@postgres:5432/sma_control?schema=public"

# --- Tenant (per-salon) database — CLI ONLY ------------------------------------
# Used only by the Prisma CLI (db push / seed) against ONE salon at a time, e.g.
# during provisioning. At runtime each salon's DB is chosen from the registry.
DATABASE_URL="postgresql://sma:change-me-strong-password@postgres:5432/salon_reine?schema=public"

# Encrypts each salon's connection string before it is stored in the registry.
# Generate one: `openssl rand -base64 32`
TENANT_DB_ENC_KEY="generate-a-long-random-32-byte-key"

# The host the platform / master console is served on. Everything else is a
# salon's custom domain. Must match a server_name in docker/nginx/conf.d/sma.conf.
PLATFORM_HOST="platform.example.com"
PLATFORM_BRAND_NAME="NS Solutions"

# Public site URL (used in metadata). Use the platform's public https URL.
NEXT_PUBLIC_SITE_URL="https://platform.example.com"

# Auth
# Generate one: `openssl rand -base64 48`
JWT_ACCESS_SECRET="generate-a-long-random-secret"
JWT_ACCESS_TTL="7d"

NODE_ENV=production

# --- Media storage ---------------------------------------------------------------
# Which backend lib/storage uses: "gcs" (default) or "supabase".
# STORAGE_PROVIDER="gcs"
# GCS_MEDIA_BUCKET="your-media-bucket"
#
# Optional fallback (Supabase):
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."
# SUPABASE_MEDIA_BUCKET="media"

# --- Optional: register the primary/demo salon during control:seed -------------
# REINE_DATABASE_URL="postgresql://sma:change-me-strong-password@postgres:5432/salon_reine?schema=public"
# REINE_DOMAIN="reine.example.com"
