# GCP project config used by scripts/ops/gcp/*.sh and the GitHub Actions
# workflows. Copy to `.env.gcp` and fill in — this file is read by the
# bootstrap scripts only (not by the app itself; Cloud Run gets its config
# via --set-env-vars / Secret Manager, see docs/deployment-gcp.md).
#   cp .env.gcp.example .env.gcp
# Never commit the real .env.gcp (it holds DB passwords and secrets).

# --- Project / region -----------------------------------------------------------
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"

# --- Artifact Registry -----------------------------------------------------------
AR_REPO="sma"

# --- Cloud Run -------------------------------------------------------------------
SERVICE_NAME="sma-app"
RUNTIME_SA_NAME="sma-runtime"          # identity the Cloud Run service/jobs run as

# --- Cloud SQL (Postgres) ---------------------------------------------------------
CLOUDSQL_INSTANCE="sma-db"
CLOUDSQL_TIER="db-g1-small"
CLOUDSQL_DB_VERSION="POSTGRES_16"
CLOUDSQL_ROOT_PASSWORD="change-me-strong-password"
CLOUDSQL_APP_USER="sma"
CLOUDSQL_APP_PASSWORD="change-me-strong-password"
CLOUDSQL_CONTROL_DB="sma_control"

# --- GitHub / Workload Identity Federation (used by deploy-cloudrun.yml) ---------
GITHUB_REPO="lakshithapramodya/sma"    # owner/repo, scopes the WIF provider
WIF_POOL="github-pool"
WIF_PROVIDER="github-provider"
DEPLOY_SA_NAME="sma-deploy"            # identity GitHub Actions impersonates

# --- App config (non-secret values, used for the initial Cloud Run deploy) ------
PLATFORM_HOST="platform.example.com"
PLATFORM_BRAND_NAME="NS Solutions"
NEXT_PUBLIC_SITE_URL="https://platform.example.com"
JWT_ACCESS_TTL="7d"

# --- App secrets (pushed into Secret Manager, never set as plain env vars) -------
# Generate: openssl rand -base64 32 / 48
TENANT_DB_ENC_KEY="generate-a-long-random-32-byte-key"
JWT_ACCESS_SECRET="generate-a-long-random-secret"

# --- Load balancer (used by setup-lb.sh / add-tenant-domain.sh) -----------------
LB_NAME="sma-lb"
LB_STATIC_IP_NAME="sma-lb-ip"
NEG_NAME="sma-neg"
BACKEND_SERVICE_NAME="sma-backend"
URL_MAP_NAME="sma-url-map"
HTTPS_PROXY_NAME="sma-https-proxy"
HTTP_PROXY_NAME="sma-http-proxy"
HTTPS_FORWARDING_RULE="sma-https-fr"
HTTP_FORWARDING_RULE="sma-http-fr"
