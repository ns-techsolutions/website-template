{
  "name": "sma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate --schema prisma/tenant/schema.prisma && prisma generate --schema prisma/control/schema.prisma",
    "control:push": "prisma db push --schema prisma/control/schema.prisma",
    "control:seed": "tsx prisma/control/seed.ts",
    "provision:tenant": "tsx scripts/provision-tenant.ts",
    "seed:demo-pages": "tsx scripts/seed-demo-pages.ts",
    "backfill:system-pages": "tsx scripts/backfill-system-pages.ts",
    "migrate:all-tenants": "tsx scripts/migrate-all-tenants.ts",
    "extract:tenant": "tsx scripts/extract-tenant.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.7",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
