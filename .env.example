# Copy to .env and fill in. (For Docker/Compose deployment use .env.docker.example
# instead — the DB host there is the `postgres` service name, not localhost.)

# --- Control-plane database (the shared registry of salons + master admins) ---
CONTROL_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sma_control?schema=public"

# --- Tenant (per-salon) database ---
# Only used by the Prisma CLI (db push / seed) against ONE salon at a time.
# At runtime each salon's database is chosen from the control-plane registry.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/salon_reine?schema=public"

# Encrypts each salon's connection string before it is stored in the registry.
# Use a 32-byte key (base64 or hex) or any long random string.
TENANT_DB_ENC_KEY="a-long-random-32-byte-key"

# The host the platform / master console is served on. Everything else is a
# salon's custom domain. In local dev `localhost` works; reach salons via their
# domains (e.g. alpha.localhost) or the dev fallback to the primary salon.
PLATFORM_HOST="localhost"

# Optional: when seeding the control-plane, also register the primary salon.
# REINE_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/salon_reine?schema=public"
# REINE_DOMAIN="reine.com"

JWT_ACCESS_SECRET="a-long-random-secret"
# Short-lived access token; silently renewed via the refresh-token cookie.
JWT_ACCESS_TTL="15m"
# Long-lived refresh token (httpOnly cookie, DB-backed + rotating).
JWT_REFRESH_TTL="30d"

# --- Media storage ---------------------------------------------------------------
# Which backend lib/storage uses: "gcs" (default) or "supabase".
# STORAGE_PROVIDER="gcs"
# GCS_MEDIA_BUCKET="your-media-bucket"
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."
# SUPABASE_MEDIA_BUCKET="media"
